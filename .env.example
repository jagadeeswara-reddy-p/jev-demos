# Copy to .env and fill in what you use. Bun loads .env automatically; keys never reach the browser.
# Models themselves are listed in models.json (built-in) and models.local.json (added in the page);
# this file only holds the keys and addresses models.json refers to. See docs/models.md.
# Restart `bun dev` after editing.

PORT=5317

# The live line-up until one is picked in the page's Models panel: model ids, left to right, up to 6.
# Built-in ids: live-jev, live-clef, live-laya, live-gemma, live-llm, bedrock-gpt, bedrock-opus, bedrock-haiku.
# Mock ids (no API calls): jev, llm-fast, llm-frontier, llm-flaky, heuristic, random, no-input.
LINEUP=live-jev,live-llm

# Jev (live-jev), through the TypeSafe API
TYPESAFE_API_KEY=

# Cloudflare Clef (live-clef), on Workers AI. The token needs Workers AI permission.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Laya (live-laya), self-hosted with laya-serve (README, "Running Laya"; deploy/ec2/launch.sh sets these)
# LAYA_BASE_URL=http://localhost:8000
# LAYA_API_KEY=                 only if laya-serve was started with one
# LAYA_HOST_NOTE=self-hosted    shown on the board

# EmbeddingGemma 2 (live-gemma), self-hosted with deploy/gemma-serve (deploy/ec2/launch.sh sets these)
# GEMMA_BASE_URL=http://localhost:8001
# GEMMA_API_KEY=
# GEMMA_HOST_NOTE=self-hosted

# Any OpenAI-compatible chat model (live-llm). More can be added in the page instead.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_LABEL=                    name on the board; defaults to LLM_MODEL

# AWS Bedrock (bedrock-gpt, bedrock-opus, bedrock-haiku). Temporary session credentials expire.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# or AWS_PROFILE=

# Where things are kept (defaults shown)
# MODELS_FILE=models.json
# LOCAL_MODELS_FILE=models.local.json
# RUNS_DIR=runs

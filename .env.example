# Copy to .env and fill in. Bun loads .env automatically; keys never reach the browser.

PORT=5317

# Boards in the live line-up, left to right. Sources: live-jev, live-laya, live-llm,
# bedrock-<key> for each BEDROCK_MODELS entry, or any mock id
# (jev, llm-fast, llm-frontier, llm-flaky, heuristic, random, no-input).
LINEUP=live-jev,live-llm

# Jev (TypeSafe System One API)
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_INPUT_PRICE_PER_M=0.042

# Laya, the open-source System One model, served by laya-serve (Jev-compatible API).
# Start it first (see the README, "Running Laya"), then set the URL and add live-laya to LINEUP.
# LAYA_BASE_URL=http://localhost:8000
# LAYA_API_KEY=                 only if laya-serve was started with LAYA_API_KEY
# LAYA_MODEL=typed-decisions    or english / multilingual
# LAYA_HOST_NOTE=self-hosted    shown on the board, e.g. "self-hosted on a T4 GPU"
# LAYA_MAX_LEN=4096             token budgets; the option list alone is ~1,100 tokens
# LAYA_HEAD_MAX_LEN=2048
# LAYA_TIMEOUT_MS=30000

# The language model to compare against.
# LLM_PROVIDER: "openai" for any OpenAI-compatible chat completions endpoint
# (OpenAI, OpenRouter, Groq, Together, vLLM, Ollama, ...) or "anthropic".
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# Name shown on the board; defaults to LLM_MODEL.
# LLM_LABEL=
# openai provider only: schema | object | none (use "object" if strict schemas aren't supported)
# LLM_JSON_MODE=schema
# Extra fields merged into every request, e.g. reasoning settings:
# LLM_EXTRA_BODY={"reasoning_effort":"low"}
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_MS=60000
# Prices in USD per million tokens, for the cost column.
# LLM_INPUT_PRICE_PER_M=0
# LLM_OUTPUT_PRICE_PER_M=0

# AWS Bedrock: any number of models, as key=model-or-inference-profile-id.
# Each becomes a source "bedrock-<key>". Credentials: the usual AWS_* variables
# (or AWS_PROFILE). Temporary session credentials expire and must be refreshed.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# BEDROCK_MODELS=gpt=us.openai.gpt-6.1-sol,claude=us.anthropic.claude-haiku-5-5
# Optional per model (KEY is the upper-cased key): BEDROCK_GPT_LABEL=,
# BEDROCK_GPT_INPUT_PRICE_PER_M=, BEDROCK_GPT_OUTPUT_PRICE_PER_M=,
# BEDROCK_GPT_CACHE_READ_PRICE_PER_M=, BEDROCK_GPT_CACHE_WRITE_PRICE_PER_M= (cache prices default to the input price)
# BEDROCK_GPT_EXTRA= a JSON object sent as the Converse API's additionalModelRequestFields,
# for provider settings such as reasoning effort, e.g. BEDROCK_GPT_EXTRA={"reasoning_effort":"low"}.
# It is shown on the board. Field names are the provider's own; check the model's Bedrock docs.
# BEDROCK_GPT_TOOL_CHOICE=auto  for models that reject a forced tool call (Claude Opus 5.5 does):
# the tool is offered but not forced, and a plain-text JSON answer is accepted too.
# Prices used so far (USD per million tokens, us. regional profiles):
#   gpt-6.1-sol       input 2.20, output 11.00, cache read 0.11, cache write 2.75
#   claude-haiku-5-5  input 0.11, output 0.55, cache read 0.011, cache write 0.1375
#   claude-opus-5-5   input 4.40, output 22.00, cache read 0.22, cache write 5.50
# BEDROCK_MAX_TOKENS=1024
# BEDROCK_TIMEOUT_MS=60000

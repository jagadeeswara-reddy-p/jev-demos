{
  "name": "decision-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark models on judgement, 2D reasoning and speed, separately, by making them play real-time games.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagadeeswara-reddy-p/jev-demos"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "bench": "bun server/bench/cli.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fake-providers": "bun scripts/fake-providers.ts",
    "smoke": "bun scripts/smoke.ts",
    "stats": "bun scripts/stats.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1149.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
